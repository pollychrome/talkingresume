{
    "name": "talking-resume",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "AI-powered interactive resume built with Cloudflare Pages and OpenAI.",
    "scripts": {
        "build": "wrangler pages functions build --outdir .wrangler/functions-build",
        "check": "npm run lint && npm run format:check && npm test && npm run build",
        "deploy": "wrangler pages deploy",
        "dev": "wrangler pages dev",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "test": "node --test"
    },
    "keywords": [
        "resume",
        "ai",
        "chatbot",
        "cloudflare",
        "openai",
        "portfolio"
    ],
    "license": "MIT",
    "engines": {
        "node": ">=22.13.0"
    },
    "devDependencies": {
        "eslint": "^10.7.0",
        "prettier": "^3.9.5",
        "wrangler": "^4.112.0"
    }
}
